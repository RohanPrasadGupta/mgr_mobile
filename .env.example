# Where the app finds the MoneyMgr API (copy to .env).
# iOS simulator / web: http://localhost:8000
# Android emulator:    http://10.0.2.2:8000  (or keep localhost and run: adb reverse tcp:8000 tcp:8000)
# Real phone:          http://<your computer's LAN IP>:8000  (same Wi-Fi)
EXPO_PUBLIC_API_URL=http://localhost:8000
